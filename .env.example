# PlanJam Environment Configuration
# Copy this file to .env or export these variables in your shell environment.

# Database
# Required for api-server and drizzle migrations:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planjam

# API Server
PORT=8080

# Frontend (Vite)
BASE_PATH=/
# Target for dev proxy when running the web app against the API server
API_TARGET=http://127.0.0.1:8080

# Optional Authentication (Clerk)
# Leave empty if running in local hackathon / anonymous mode
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_CLERK_PROXY_URL=http://localhost:8080/api/__clerk
